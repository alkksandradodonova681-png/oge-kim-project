{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Task",
  "type": "object",
  "required": ["taskId", "subjectId", "positionId", "topicId", "prototypeId", "difficulty", "type", "text", "maxPoints"],
  "properties": {
    "taskId": { "type": "string" },
    "subjectId": { "type": "string", "enum": ["MATH-OGE", "PHYS-OGE"] },
    "positionId": { "type": "integer" },
    "topicId": { "type": "string" },
    "prototypeId": { "type": "string" },
    "difficulty": { "type": "number" },
    "type": { "type": "string", "enum": ["multiple_choice", "short_answer", "extended_answer"] },
    "text": { "type": "string" },
    "formulas": { "type": "array", "items": { "type": "string" } },
    "resources": { "type": "array", "items": { "type": "string" } },
    "answers": { "type": "array", "items": { "type": "string" } },
    "correctKey": { "type": "array", "items": { "type": "string" } },
    "criteria": { "type": "array", "items": { "type": "object", "properties": { "description": { "type": "string" }, "points": { "type": "number" } } } },
    "maxPoints": { "type": "number" }
  }
}
